{
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "--from",
        "code-review-graph[communities]==2.3.9",
        "code-review-graph",
        "serve",
        "--tools",
        "get_minimal_context_tool,build_or_update_graph_tool,query_graph_tool,semantic_search_nodes_tool,traverse_graph_tool,get_impact_radius_tool,detect_changes_tool,get_affected_flows_tool,get_review_context_tool,list_graph_stats_tool,get_docs_section_tool"
      ],
      "env": {
        "CRG_TOOL_TIMEOUT": "30"
      }
    }
  }
}
